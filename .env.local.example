NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# 部分 Supabase 專案使用 publishable key 名稱
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 管理員電郵（逗號分隔，可選；預設 vcgrouphk@gmail.com）
ADMIN_EMAILS=vcgrouphk@gmail.com

# 新 Lead / Affiliate 申請電郵通知（Resend，生產環境建議設定）
RESEND_API_KEY=re_xxxxxxxx
ADMIN_NOTIFY_EMAIL=vcgrouphk@gmail.com
NOTIFY_FROM_EMAIL=VCG 通知 <onboarding@resend.dev>

# 網站 URL（推廣連結、OG、sitemap、通知郵件內的後台連結）
# 本地開發：
NEXT_PUBLIC_SITE_URL=http://localhost:3002
# 正式上線（Vercel Production）改為根域名，勿加 /auth/callback：
# NEXT_PUBLIC_SITE_URL=https://hksmeloan.com

# Google Analytics 4（GA4 管理后台 → 資料串流 → Measurement ID，格式 G-XXXXXXXXXX）
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Cloudflare Turnstile（生產環境建議設定 — 防 spam）
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# 推廣統計：無 CDN 國家 header 時是否視為香港（本地 dev 預設 development 已放行）
# AFFILIATE_GEO_UNKNOWN_AS_HK=true
# 點擊去重用 IP 雜湊 salt（生產環境建議自訂）
# AFFILIATE_IP_HASH_SALT=your-random-salt

# Cloudflare R2（會員／Lead 文件上傳，生產環境必填）
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=vcg-media
# 公開 CDN 網址（建議綁自訂域名，如 https://media.yourdomain.com）
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
